#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HRML: HRML {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <150>;
            require-prior-idle-ms = <210>;
            hold-trigger-on-release;
        };

        HRMR: HRMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <150>;
            require-prior-idle-ms = <210>;
            hold-trigger-on-release;
        };

        LTR: LTR {
            compatible = "zmk,behavior-hold-tap";
            label = "LTR";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "balanced";
            quick-tap-ms = <145>;
            require-prior-idle-ms = <100>;
            hold-trigger-on-release;
        };

        LTL: LTL {
            compatible = "zmk,behavior-hold-tap";
            label = "LTL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <160>;
            flavor = "balanced";
            quick-tap-ms = <145>;
            require-prior-idle-ms = <100>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        Capslock {
            bindings = <&kp CAPSLOCK>;
            key-positions = <5 6>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <4 7>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <17 18>;
        };

        underscore {
            bindings = <&kp LS(MINUS)>;
            key-positions = <3 8>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | ESC   |
            // | BSPC |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '    |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | LCTRL |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp LEFT_ALT   &kp Q             &kp W              &kp F               &kp P                 &kp B           &kp J          &kp L                  &kp U                &kp Y             &mt SEMICOLON COLON  &mt K_NEXT K_PLAY_PAUSE
&kp BACKSPACE  &HRML LEFT_GUI A  &HRML RIGHT_ALT R  &HRML LEFT_SHIFT S  &HRML LEFT_CONTROL T  &kp G           &kp M          &HRMR RIGHT_CONTROL N  &HRMR RIGHT_SHIFT E  &HRMR LEFT_ALT I  &HRMR RIGHT_GUI O    &kp SINGLE_QUOTE
&kp DELETE     &kp Z             &kp X              &kp C               &kp D                 &kp V           &kp K          &kp H                  &kp COMMA            &kp DOT           &kp SLASH            &none
                                                    &LTL 3 ESCAPE       &LTL 2 BACKSPACE      &LTL 1 SPACE    &LTR 1 RETURN  &LTR 2 TAB             &LTR 3 ESCAPE
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT     |

            bindings = <
&none      &kp MINUS      &mt LS(N7) N7              &mt LS(N8) N8              &mt LS(N9) N9              &none        &none    &kp EQUAL  &kp HOME   &kp END  &mt LS(SEMI) SEMI  &none
&kp SLASH  &mt LS(N0) N0  &mt LS(NUMBER_4) NUMBER_4  &mt LS(N5) N5              &mt LS(NUMBER_6) NUMBER_6  &none        &none    &kp LEFT   &kp DOWN   &kp UP   &kp RIGHT          &none
&kp EQUAL  &kp PLUS       &mt LS(NUMBER_1) NUMBER_1  &mt LS(NUMBER_2) NUMBER_2  &mt LS(NUMBER_3) NUMBER_3  &none        &none    &kp ASTRK  &kp COMMA  &kp DOT  &kp SLASH          &none
                                                     &trans                     &trans                     &kp SPACE    &kp RET  &trans     &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB        &none            &kp AT             &kp HASH         &kp DLLR               &none           &none          &kp PERCENT  &kp EQUAL  &kp CARET      &kp SEMI  &none
&kp BACKSPACE  &kp EXCLAMATION  &kp LEFT_BRACKET   &kp LEFT_BRACE   &kp LEFT_PARENTHESIS   &none           &kp AMPS       &kp MINUS    &kp GRAVE  &kp PIPE       &kp STAR  &none
&kp DELETE     &kp PLUS         &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &none           &none          &kp UNDER    &kp TILDE  &kp BACKSLASH  &none     &none
                                                   &mo 3            &kp BACKSPACE          &LTL 1 SPACE    &LTR 1 RETURN  &kp TAB      &mo 3
            >;
        };

        layer_3 {
            bindings = <
&kp F1      &kp F2  &kp F3      &kp F4      &kp F5      &kp F6         &kp F7       &kp F8                  &kp F9                  &kp F10                  &kp F11                  &kp F12
&none       &none   &bt BT_PRV  &bt BT_CLR  &bt BT_NXT  &soft_off      &soft_off    &kp LS(LG(LEFT_ARROW))  &kp LS(LG(DOWN_ARROW))  &kp LS(LG(UP_ARROW))     &kp LS(LG(RIGHT_ARROW))  &none
&sys_reset  &none   &none       &none       &none       &bootloader    &bootloader  &kp K_VOLUME_DOWN       &kp K_VOLUME_UP         &mt K_NEXT K_PLAY_PAUSE  &kp K_MUTE               &sys_reset
                                &none       &none       &none          &none        &none                   &none
            >;
        };
    };
};
